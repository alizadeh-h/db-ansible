[mysqld]
user                    = mysql
pid-file                = /run/mysqld/mysqld.pid
socket                  = /run/mysqld/mysqld.sock
port                    = 3306
basedir                 = /usr
datadir                 = /var/lib/mysql
tmpdir                  = /tmp
lc-messages-dir         = /usr/share/mysql

bind-address            = 0.0.0.0
query_cache_size        = 0
binlog_format           = ROW
default_storage_engine  = InnoDB
innodb_autoinc_lock_mode = 2
skip-name-resolve

server-id = {{ play_hosts.index(inventory_hostname) + 1 }}

# Galera

wsrep_on=ON
wsrep_provider=/usr/lib/galera/libgalera_smm.so
wsrep_cluster_name="my_galera_cluster"

wsrep_cluster_address="gcomm://{% for host in groups['db_servers'] %}{{ hostvars[host].private_ip }}{% if not loop.last %},{% endif %}{% endfor %}"
wsrep_node_address="{{ hostvars[inventory_hostname].private_ip }}"
wsrep_node_name="{{ inventory_hostname }}"

wsrep_sst_method=rsync

